{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-triage/schemas/stage-contracts.json",
  "title": "六段 Stage 输入/输出契约（权威定义：mode 与 payload 以本文件为准）",
  "x-mode-authority": {
    "monitor": ["scan"],
    "triage": ["full", "classify_only"],
    "reproduction": ["run"],
    "ticket": ["run"],
    "review": ["run"],
    "reporting": ["case", "daily"]
  },
  "$defs": {
    "signal": { "enum": ["none", "error"] },
    "rca": { "enum": ["driver", "test", "environment", "infrastructure", "unknown"] },
    "reproducible": { "enum": ["yes", "no", "flaky", "blocked"] },
    "case_ref": { "type": "object", "required": ["case_id"], "properties": { "case_id": { "type": "string" } } }
  },
  "stages": {
    "monitor": {
      "command_subject": "ci.cmd.monitor.scan",
      "result_subject": "ci.result.monitor",
      "modes": ["scan"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "const": "scan" },
          "input": {
            "type": "object",
            "required": ["scan_id", "lookback"],
            "properties": {
              "scan_id": { "type": "string" },
              "lookback": { "type": "string", "maxLength": 16 },
              "jobs_filter": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
              "dry_run": { "type": "boolean" }
            }
          }
        }
      },
      "output": {
        "required": ["scan_id", "observations", "counts"],
        "properties": {
          "scan_id": { "type": "string" },
          "observations": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": ["source", "job", "build", "result", "signal"],
              "properties": {
                "obs_id": { "type": "string" },
                "source": { "type": "string", "maxLength": 32 },
                "job": { "type": "string", "maxLength": 128 },
                "build": { "type": ["integer", "null"] },
                "result": { "type": "string", "maxLength": 32 },
                "signal": { "$ref": "#/$defs/signal" },
                "signature": { "type": ["string", "null"] },
                "noise_score": { "type": "number", "minimum": 0, "maximum": 1 },
                "known_issue_ref": { "type": ["string", "null"] },
                "promoted_reason": { "type": ["string", "null"] },
                "suppressed": { "type": "boolean" },
                "log_excerpt": { "type": ["string", "null"], "maxLength": 4000 },
                "evidence_refs": { "type": "array", "maxItems": 20 },
                "context": { "type": "object" }
              }
            }
          },
          "counts": {
            "type": "object",
            "required": ["observed", "promoted", "suppressed"],
            "properties": {
              "observed": { "type": "integer", "minimum": 0 },
              "promoted": { "type": "integer", "minimum": 0 },
              "suppressed": { "type": "integer", "minimum": 0 }
            }
          },
          "scan_window": { "type": "string" },
          "source_status": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "triage": {
      "command_subject": "ci.cmd.triage.run",
      "result_subject": "ci.result.triage",
      "modes": ["full", "classify_only"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "enum": ["full", "classify_only"] },
          "input": {
            "type": "object",
            "required": ["case_id", "source", "job", "signal"],
            "properties": {
              "case_id": { "type": "string" },
              "build": { "type": ["integer", "null"] },
              "source": { "type": "string" },
              "job": { "type": "string" },
              "signal": { "$ref": "#/$defs/signal" },
              "signature": { "type": ["string", "null"] },
              "log_excerpt": { "type": ["string", "null"] },
              "context": { "type": "object" },
              "evidence_refs": { "type": "array", "maxItems": 20 }
            }
          }
        }
      },
      "output": {
        "required": ["case_id", "rca", "repro_eligible", "evidence"],
        "properties": {
          "case_id": { "type": "string" },
          "rca": { "$ref": "#/$defs/rca" },
          "component": { "type": "string", "maxLength": 128 },
          "os_stage": { "type": ["string", "null"], "maxLength": 64 },
          "signature": { "type": ["string", "null"] },
          "duplicate_of": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "key_frames": { "type": "array", "maxItems": 12 },
          "repro_eligible": { "type": "boolean" },
          "repro_block_reason": { "type": ["string", "null"] },
          "triage_notes": { "type": "array", "maxItems": 10 },
          "evidence": { "type": "array", "maxItems": 30 },
          "skill_refs": { "type": "array", "maxItems": 10 },
          "llm_calls": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "reproduction": {
      "command_subject": "ci.cmd.reproduction.run",
      "result_subject": "ci.result.reproduction",
      "modes": ["run"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "const": "run" },
          "input": {
            "type": "object",
            "required": ["case_id", "source", "job", "rca"],
            "properties": {
              "case_id": { "type": "string" },
              "build": { "type": ["integer", "null"] },
              "source": { "type": "string" },
              "job": { "type": "string" },
              "rca": { "$ref": "#/$defs/rca" },
              "signature": { "type": ["string", "null"] },
              "key_frames": { "type": "array", "maxItems": 12 },
              "requested_focus": { "type": ["string", "null"], "maxLength": 500 }
            }
          }
        }
      },
      "output": {
        "required": ["case_id", "reproducible"],
        "properties": {
          "case_id": { "type": "string" },
          "reproducible": { "$ref": "#/$defs/reproducible" },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 10 },
          "matrix": { "type": "array", "maxItems": 10 },
          "steps_summary": { "type": "array", "maxItems": 12 },
          "new_evidence": { "type": "array", "maxItems": 30 },
          "blocked_reason": { "type": ["string", "null"] },
          "log_excerpt": { "type": ["string", "null"], "maxLength": 4000 }
        }
      }
    },
    "ticket": {
      "command_subject": "ci.cmd.ticket.run",
      "result_subject": "ci.result.ticket",
      "modes": ["run"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "const": "run" },
          "input": {
            "type": "object",
            "required": ["case_id", "source", "job", "signal", "rca"],
            "properties": {
              "case_id": { "type": "string" },
              "build": { "type": ["integer", "null"] },
              "source": { "type": "string" },
              "job": { "type": "string" },
              "signal": { "$ref": "#/$defs/signal" },
              "signature": { "type": ["string", "null"] },
              "rca": { "$ref": "#/$defs/rca" },
              "reproducible": { "type": ["string", "null"] },
              "requested_focus": { "type": ["string", "null"] }
            }
          }
        }
      },
      "output": {
        "required": ["case_id", "backend", "ticket_status"],
        "properties": {
          "case_id": { "type": "string" },
          "backend": { "type": "string", "maxLength": 32 },
          "external_key": { "type": ["string", "null"], "maxLength": 64 },
          "url": { "type": ["string", "null"], "maxLength": 256 },
          "ticket_status": { "enum": ["created", "drafted", "linked_duplicate", "failed"] },
          "duplicate_of": { "type": ["string", "null"] },
          "ticket_priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "assignee_team": { "type": ["string", "null"], "maxLength": 64 },
          "linked_prs": { "type": "array", "maxItems": 10 },
          "sections": { "type": "array", "maxItems": 20 },
          "audit": { "type": "object" }
        }
      }
    },
    "review": {
      "command_subject": "ci.cmd.review.run",
      "result_subject": "ci.result.review",
      "modes": ["run"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "const": "run" },
          "input": {
            "type": "object",
            "required": ["case_id", "source", "job", "signal", "rca"],
            "properties": {
              "case_id": { "type": "string" },
              "build": { "type": ["integer", "null"] },
              "source": { "type": "string" },
              "job": { "type": "string" },
              "signal": { "$ref": "#/$defs/signal" },
              "signature": { "type": ["string", "null"] },
              "rca": { "$ref": "#/$defs/rca" },
              "confidence": { "type": ["number", "null"] },
              "reproducible": { "type": ["string", "null"] },
              "ticket_status": { "type": ["string", "null"] },
              "ticket_sections": { "type": "array", "maxItems": 20 },
              "duplicate_of": { "type": ["string", "null"] },
              "evidence_count": { "type": "integer", "minimum": 0 },
              "requested_focus": { "type": ["string", "null"] },
              "loop_seq": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      },
      "output": {
        "required": ["case_id", "verdict"],
        "properties": {
          "case_id": { "type": "string" },
          "verdict": { "enum": ["approve", "needs_info", "reject"] },
          "reason_code": { "enum": ["ok", "insufficient_evidence", "inconsistent_evidence",
                                    "missing_repro", "missing_ticket_sections", "duplicate_ticket",
                                    "missing_triage", "mock_reject", "loop_exhausted"] },
          "requested_info": { "type": "array", "maxItems": 10 },
          "checks": { "type": "array", "maxItems": 20 },
          "quality_scores": { "type": "object" },
          "notes": { "type": ["string", "null"], "maxLength": 1000 }
        }
      }
    },
    "reporting": {
      "command_subject": "ci.cmd.reporting.{case|daily}",
      "result_subject": "ci.result.reporting",
      "modes": ["case", "daily"],
      "input": {
        "required": ["mode", "input"],
        "properties": {
          "mode": { "enum": ["case", "daily"] },
          "input": {
            "type": "object",
            "properties": {
              "case_id": { "type": ["string", "null"] },
              "day": { "type": ["string", "null"] }
            }
          }
        }
      },
      "output": {
        "properties": {
          "case_id": { "type": ["string", "null"] },
          "day": { "type": ["string", "null"] },
          "report_md": { "type": "string", "maxLength": 20000 },
          "metrics": { "type": "object" }
        }
      }
    }
  },
  "x-path-matrix": {
    "s1_lite": ["triage:classify_only"],
    "s2_full": ["triage:full", "reproduction:run", "ticket:run", "review:run", "reporting:case"],
    "s3_direct_report": ["triage:classify_only", "reporting:case"]
  }
}
