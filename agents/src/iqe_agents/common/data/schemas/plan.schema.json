{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-triage/schemas/plan.schema.json",
  "title": "执行计划契约（workflow 与 LLM 计划共用同一契约，carrier=YAML）",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "version", "source", "steps", "validator", "created_at"],
  "properties": {
    "plan_id": { "type": "string", "pattern": "^[0-9A-Z]{26}$" },
    "version": { "const": 1 },
    "source": { "enum": ["workflow", "llm"] },
    "workflow_key": { "type": ["string", "null"], "maxLength": 64 },
    "degraded": { "type": "boolean", "default": false },
    "created_at": { "type": "string", "format": "date-time" },
    "scope": { "enum": ["case", "scan", "daily"], "default": "case" },
    "signal": { "enum": ["none", "error", "unknown"], "default": "unknown" },
    "rationale": { "type": ["string", "null"], "maxLength": 500 },
    "model": { "type": ["string", "null"], "maxLength": 128 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "prompt_hash": { "type": ["string", "null"], "maxLength": 64 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
          "stage": {
            "enum": ["triage", "reviewer", "remediation", "reproduction", "regression",
                     "ticketing", "reporting"]
          },
          "mode": {
            "enum": ["classify", "gate1", "gate2", "gate3", "fix", "evidence", "verify",
                     "check", "bisect", "create", "case", "daily"],
            "description": "stage-contracts 的 x-mode-authority 为权威：mode 与 stage 必须匹配"
          },
          "max_attempts": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 },
          "timeout_s": { "type": "number", "minimum": 1, "maximum": 600, "default": 30 },
          "on": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "internal": { "$ref": "#/$defs/route" },
              "external": { "$ref": "#/$defs/route" },
              "approve": { "$ref": "#/$defs/route" },
              "rework": { "$ref": "#/$defs/jump" },
              "needs_info": { "$ref": "#/$defs/jump" },
              "reject": { "$ref": "#/$defs/route" },
              "regression": { "$ref": "#/$defs/route" },
              "not_regression": { "$ref": "#/$defs/route" },
              "done": { "$ref": "#/$defs/route" },
              "blocked": { "$ref": "#/$defs/route" }
            }
          }
        }
      }
    },
    "validator": { "const": "plan-validator/v1" }
  },
  "$defs": {
    "status": {
      "enum": ["created", "triaged", "routed_internal", "routed_external", "remediated",
               "fix_verified", "fix_approved", "reproduced", "regression_checked", "bisected",
               "ticketed", "ticket_approved", "reported", "closed", "closed_rejected", "blocked"]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "next": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
        "end": { "type": "boolean" },
        "set_status": { "$ref": "#/$defs/status" }
      }
    },
    "jump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jump"],
      "properties": {
        "jump": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
        "max_loops": { "type": "integer", "minimum": 1, "maximum": 3 },
        "set_status": { "$ref": "#/$defs/status" }
      }
    }
  },
  "x-counterexamples": [
    {
      "plan_id": "01JB9ZK3Q7W7X8Y9Z0A1B2C3D7",
      "version": 1,
      "source": "llm",
      "created_at": "2026-11-25T10:10:00Z",
      "signal": "error",
      "rationale": "跳过闸门 1 直接修复（违反 V4：error 计划必须先去 gate1 分流）",
      "steps": [
        { "id": "t1", "stage": "triage", "mode": "classify" },
        { "id": "r1", "stage": "remediation", "mode": "fix" },
        { "id": "v1", "stage": "reproduction", "mode": "verify" },
        { "id": "p1", "stage": "reporting", "mode": "case" }
      ],
      "validator": "plan-validator/v1"
    }
  ]
}
