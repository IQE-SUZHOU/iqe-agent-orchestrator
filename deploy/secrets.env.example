# 复制到 deploy/secrets.env 后填真实值；deploy/secrets.env 已被 .gitignore 排除，不要提交。
# deploy/deploy.sh 与 tools/run_local.sh 会自动 source 它（set -a 全量导出）。

# --- 基础设施凭据（复用集群现有 RabbitMQ / Postgres，本仓库不新建实例）---
export PG_PASSWORD='CHANGE_ME'
export RABBITMQ_ADMIN_PASS='CHANGE_ME'
export CI_APP_PASS='CHANGE_ME'          # 本系统 7 个 MQ 账号（ci_orch / ci_agent_*）共用的口令

# --- 镜像仓库 ---
export HARBOR_REGISTRY='172.31.0.3:7777'
export HARBOR_USER='CHANGE_ME'
export HARBOR_PASS='CHANGE_ME'

# --- 集群内服务地址（写进 k8s Secret 的连接串用这些主机名）---
export PG_CLUSTER_HOST='postgres.infra-database.svc.cluster.local'
export PG_PORT='5432'
export AMQP_HOST='rabbitmq.infra-database.svc.cluster.local'
export AMQP_PORT='5672'

# --- 本机直连用（ClusterIP；172.31.0.3:5432 被 pg_hba 拒绝，只能走 ClusterIP）---
export PG_ADMIN="postgresql://postgres:${PG_PASSWORD}@10.96.75.0:5432/ci_triage"
export AMQP_HOST_LOCAL='10.100.200.12:5672'

# --- 可选：覆盖部署目标 ---
# export REPO='172.31.0.3:7777/library/ci-triage'
# export TAG='20261126-1200-abcdef123456'
