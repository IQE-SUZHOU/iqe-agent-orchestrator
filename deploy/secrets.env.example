# 复制到 deploy/secrets.env 后填真实值；deploy/secrets.env 已被 .gitignore 排除，不要提交。
# deploy/deploy.sh 与 scripts/run_local.sh 会自动 source 它（set -a 全量导出）。
#
# 原则：业务只用「本系统专属账号」（PG_APP_USER / CI_APP_PASS / HARBOR robot）。
# 共享超户（PG postgres、MQ admin、Harbor admin）只在建库、建 MQ 账号时按需使用，
# 不参与运行时——这样共享实例的口令轮换不会打挂本系统，反之亦然。

# --- 本系统专属账号（业务运行时只需要这三项）---
export CI_APP_PASS='CHANGE_ME'          # 9 个 MQ 账号（ci_orch + 8 个 ci_agent_*）共用的口令
export PG_APP_USER='ci_triage_app'      # 仅拥有 ci_triage 库；建法见 docs/operations.md「凭据与账号」
export PG_APP_PASS='CHANGE_ME'

# --- 共享基础设施超户（按需；建库 / 建 MQ 账号才用到）---
export PG_PASSWORD='CHANGE_ME'          # Postgres 超级用户，集群内多服务共用
export RABBITMQ_ADMIN_PASS='CHANGE_ME'  # RabbitMQ 管理台 admin，集群内多服务共用

# --- 镜像仓库：用项目级 robot 账号，权限仅 iqe-agent-orchestrator 项目的 push/pull ---
# 建法：POST /api/v2.0/robots，level=project、namespace=iqe-agent-orchestrator、repository push+pull
export HARBOR_REGISTRY='172.31.0.3:7777'
export HARBOR_USER='robot$iqe-agent-orchestrator+deploy'
export HARBOR_PASS='CHANGE_ME'
# 生产主镜像与演示 all-in-one 镜像是两个不同的仓库，变量名必须分开。
# 两个脚本都会先 source 本文件（set -a），如果共用一个 REPO 变量，
# build_allinone.sh 里的 "${REPO:-…-allinone}" 默认值永远不生效，
# 结果会把 all-in-one 镜像推进生产主镜像仓库、连 latest 一起覆盖掉（真发生过）。
export IMAGE_REPO='172.31.0.3:7777/iqe-agent-orchestrator/iqe-agent-orchestrator'
export ALLINONE_REPO='172.31.0.3:7777/iqe-agent-orchestrator/iqe-agent-orchestrator-allinone'

# --- 集群内服务地址（写进 k8s Secret 的连接串用这些主机名）---
export PG_CLUSTER_HOST='postgres.infra-database.svc.cluster.local'
export PG_PORT='5432'
export AMQP_HOST='rabbitmq.infra-database.svc.cluster.local'
export AMQP_PORT='5672'

# --- 本机直连用（ClusterIP；172.31.0.3:5432 被 pg_hba 拒绝，只能走 ClusterIP）---
export PG_APP_DSN_LOCAL="postgresql://${PG_APP_USER}:${PG_APP_PASS}@10.96.75.0:5432/ci_triage"
export PG_ADMIN="postgresql://postgres:${PG_PASSWORD}@10.96.75.0:5432/ci_triage"   # 仅建库用
export PG_DSN="$PG_APP_DSN_LOCAL"                                                    # 本机跑服务/测试用
export AMQP_HOST_LOCAL='10.100.200.12:5672'

# --- 可选：覆盖部署目标 ---
# export TAG='20261126-1200-abcdef123456'
