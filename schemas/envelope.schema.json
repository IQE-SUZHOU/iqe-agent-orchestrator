{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-triage/schemas/envelope.schema.json",
  "title": "总线消息信封（总线无关，RabbitMQ 4.1 映射见 design/02 §2.5）",
  "type": "object",
  "required": ["msg_id", "msg_type", "schema", "produced_at", "produced_by",
               "correlation_id", "stage", "payload"],
  "properties": {
    "msg_id": { "type": "string", "pattern": "^[0-9A-Z]{26}$" },
    "msg_type": { "enum": ["command", "result", "event", "control"] },
    "schema": { "const": "v1" },
    "produced_at": { "type": "string", "format": "date-time" },
    "produced_by": { "enum": ["scheduler", "orchestrator", "monitor", "triage", "reproduction",
                              "ticket", "review", "reporting", "ops", "none"] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"] },
    "case_id": { "type": ["string", "null"] },
    "stage": { "enum": ["none", "monitor", "triage", "reproduction", "ticket", "review", "reporting"] },
    "step_id": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{0,15}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+:[a-z][a-z0-9_]*:[0-9]+$" },
    "ttl_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 9 },
    "scenario_hint": { "type": ["string", "null"], "maxLength": 64 },
    "payload": { "type": "object" },
    "evidence_refs": { "type": "array", "maxItems": 50 }
  },
  "allOf": [
    {
      "if": { "properties": { "msg_type": { "const": "command" } } },
      "then": {
        "required": ["attempt", "idempotency_key", "ttl_ms", "stage"],
        "properties": { "stage": { "not": { "const": "none" } } }
      }
    },
    {
      "if": { "properties": { "msg_type": { "const": "result" } } },
      "then": {
        "required": ["attempt", "idempotency_key"],
        "properties": {
          "payload": {
            "required": ["stage", "attempt", "status"],
            "properties": {
              "stage": { "enum": ["monitor", "triage", "reproduction", "ticket", "review", "reporting"] },
              "attempt": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["ok", "retryable", "blocked", "expired"] },
              "output": { "type": "object" },
              "error": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": { "enum": ["timeout", "mock_fault", "schema_invalid", "schema_mismatch",
                                     "no_evidence", "disabled", "source_unavailable", "quota_exceeded"] },
                  "detail": { "type": "string", "maxLength": 1000 },
                  "evidence_refs": { "type": "array", "maxItems": 20 }
                }
              }
            },
            "allOf": [
              { "if": { "properties": { "status": { "const": "ok" } } }, "then": { "required": ["output"] } },
              { "if": { "properties": { "status": { "enum": ["retryable", "blocked", "expired"] } } },
                "then": { "required": ["error"] } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "msg_type": { "const": "event" } } },
      "then": { "properties": { "payload": { "required": ["event"] } } }
    }
  ]
}
