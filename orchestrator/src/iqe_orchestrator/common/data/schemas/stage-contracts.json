              "null"
            ],
            "properties": {
              "commit": {
                "type": "string",
                "maxLength": 64
              },
              "pr": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "author": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          },
          "candidates": {
            "type": "array",
            "maxItems": 20
          },
          "evidence": {
            "type": "array",
            "maxItems": 30
          },
          "notes": {
            "type": "array",
            "maxItems": 10
          }
        }
      }
    },
    "ticketing": {
      "command_subject": "ci.cmd.ticketing.create",
      "result_subject": "ci.result.ticketing",
      "modes": [
        "create"
      ],
      "input": {
        "required": [
          "mode",
          "input"
        ],
        "properties": {
          "mode": {
            "const": "create"
          },
          "input": {
            "type": "object",
            "required": [
