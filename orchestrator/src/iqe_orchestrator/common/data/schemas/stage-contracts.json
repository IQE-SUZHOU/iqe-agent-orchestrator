              },
              "reproduction": {
                "type": "object"
              },
              "regression": {
                "type": "object"
              },
              "requested_focus": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "duplicate_of": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              }
            }
          }
        }
      },
      "output": {
        "required": [
          "case_id",
          "backend",
          "ticket_status"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "maxLength": 32
          },
          "external_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
