                ],
                "maxLength": 64
              },
              "change_window": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              },
              "requested_focus": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              }
            }
          }
        }
      },
      "output": {
        "required": [
          "case_id",
          "mode",
          "is_regression"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "check",
              "bisect"
            ]
          },
          "is_regression": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "baseline": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "change_window": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "bisected": {
            "type": "boolean"
          },
          "guilty_patch": {
            "type": [
